<?xml version="1.0" encoding="utf-8"?>
<!--
  Заставка: сплошной фирменный фон + логотип по центру.
  Раньше на окно вешали bitmap-фон (@drawable/splash.png) — он растягивался
  на весь экран, из-за чего логотип получался сплюснутым/растянутым, а на
  портрете использовался ландшафтный ассет. Layer-list с gravity="center"
  логотип не искажает: фон заливает экран цветом, а логотип стоит по центру
  в натуральном соотношении сторон.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center"
            android:tileMode="disabled" />
    </item>
</layer-list>
